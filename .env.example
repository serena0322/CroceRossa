# ============================================================
# Configurazione SMTP — Croce Rossa Italiana
# ============================================================
# Copiare questo file in ".env" e compilare i valori reali.
# Il file ".env" NON deve essere committato su Git.
# ============================================================

# Host del server SMTP (es. smtp.gmail.com per Gmail)
SMTP_HOST=smtp.gmail.com

# Porta SMTP (587 per TLS/STARTTLS, 465 per SSL)
SMTP_PORT=587

# Indirizzo email mittente (account Gmail o altro provider)
SMTP_USER=tuo-account@gmail.com

# Password dell'account SMTP.
# Per Gmail: usare una "App Password" (non la password principale).
# Generabile da: Impostazioni Google → Sicurezza → Password per le app
SMTP_PASS=your-app-password-here
